{
  "author": "SMAKSS",
  "bugs": {
    "url": "https://github.com/SMAKSS/uuid/issues"
  },
  "description": "Generates random unique UUID string based on RFC 4122 approach.",
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.3",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "semantic-release": "^25.0.3",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@types/node": "^26.6.6",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tslib": "^2.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/SMAKSS/uuid#readme",
  "keywords": [
    "npm",
    "yarn",
    "UUID",
    "unique",
    "SMAKSS",
    "random",
    "RFC-4122",
    "CommonJS",
    "EcmaScript",
    "Typescript",
    "unique-string",
    "random-string",
    "random-unique-string"
  ],
  "license": "MIT",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "name": "@smakss/uuid",
  "packageManager": "pnpm@12.17.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SMAKSS/uuid.git"
  },
  "scripts": {
    "build:playground": "pnpm run generate && pnpm --filter uuid-playground build",
    "dev:playground": "pnpm run generate && pnpm --filter uuid-playground dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate": "vite build && pnpm run generate:types",
    "generate:types": "tsc -p tsconfig.build.json && node create-declaration-entrypoints.js",
    "generate:check": "pnpm run format && pnpm run lint && pnpm run typecheck",
    "lint": "pnpm run lint:main && pnpm run lint:playground",
    "lint:main": "oxlint --deny-warnings --ignore-pattern 'playground/**' .",
    "lint:playground": "pnpm --filter uuid-playground lint",
    "lint:fix": "oxlint --fix src",
    "setup": "pnpm install && pnpm exec husky install",
    "release": "semantic-release",
    "test": "pnpm run generate && node --test",
    "typecheck": "tsc -b . && pnpm run generate:types && tsc -p tsconfig.package-types.json && pnpm --filter uuid-playground typecheck",
    "typecheck:playground": "pnpm run generate:types && pnpm --filter uuid-playground typecheck"
  },
  "type": "module",
  "types": "./dist/index.d.cts",
  "version": "2.1.0"
}
